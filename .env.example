# Copiar este archivo a .env (nunca versionar .env real) antes de `docker compose up --build`.

# --- EventService / eventdb ---
EVENTDB_NAME=eventdb
EVENTDB_USER=eventservice
EVENTDB_PASSWORD=eventservice_pw
EVENTDB_PORT=5432
EVENT_API_PORT=8080

# --- NotificationService / notificationdb ---
NOTIFICATIONDB_NAME=notificationdb
NOTIFICATIONDB_USER=notificationservice
NOTIFICATIONDB_PASSWORD=notificationservice_pw
NOTIFICATIONDB_PORT=5433
NOTIFICATION_API_PORT=8081

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Redis ---
REDIS_PORT=6379

# --- SMTP (NotificationService) — OPCIONAL ---
# Si SMTP_HOST queda vacío, NotificationService simula el correo (solo lo loguea, sin SMTP real).
# Para recibir un correo de verdad, completá estos valores con tu propio proveedor. Ejemplo con
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=tu-correo@gmail.com,
# SMTP_PASSWORD=<contraseña de aplicación de 16 caracteres, no tu contraseña normal — requiere
# verificación en 2 pasos activada en tu cuenta de Google>. Nunca commitear una contraseña real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@plataforma-eventos.local
SMTP_FROM_NAME=Plataforma de Eventos
SMTP_TO_ADDRESS=demo@plataforma-eventos.local

# --- Seguridad (JWT local, Fase 1 — Constitucion §5.1) ---
# DEBE tener al menos 32 bytes (research.md §4b). Generar uno propio, ej.: openssl rand -base64 32
JWT_SIGNING_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# --- Observabilidad (Spec 02 — Tempo/Loki/Prometheus/Grafana) ---
# Credenciales y puertos solo del entorno local de docker-compose (Constitucion §4: no son
# secretos reales, nunca se exponen a internet). Cambiar GRAFANA_ADMIN_PASSWORD si se quiere.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
TEMPO_PORT=3200

# --- Frontend ---
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_EVENT_URL=http://localhost:8080
# JWT de demo con rol Admin que usa el Frontend (ver README §5). Este valor está firmado con el
# JWT_SIGNING_KEY placeholder de arriba; si lo cambiás, regenerá este token con:
#   dotnet run --project tools/generate-demo-token -- Admin "<tu-JWT_SIGNING_KEY>"
VITE_ADMIN_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJkZW1vLWFkbWluIiwicm9sZSI6IkFkbWluIiwiZXhwIjoxNzg5NDAyNDU3fQ.jYgfG1Ugp5wzF5I1eIt_IequLME1dbKsNiEOFgkWBwA

ASPNETCORE_ENVIRONMENT=Development
