      ]
    },
    {
      "name": "Eventos - autorización (matriz)",
      "item": [
        {
          "name": "POST /events sin token -> 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{eventApiUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"x\",\n  \"date\": \"2026-01-01T00:00:00Z\",\n  \"location\": \"x\",\n  \"zones\": [ { \"name\": \"x\", \"price\": 1, \"capacity\": 1 } ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /events sin token -> 401",
          "request": {
            "method": "GET",
            "url": "{{eventApiUrl}}/events"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /events con rol User -> 403",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{eventApiUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"x\",\n  \"date\": \"2026-01-01T00:00:00Z\",\n  \"location\": \"x\",\n  \"zones\": [ { \"name\": \"x\", \"price\": 1, \"capacity\": 1 } ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403 Forbidden (autenticado pero sin rol Admin)', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
