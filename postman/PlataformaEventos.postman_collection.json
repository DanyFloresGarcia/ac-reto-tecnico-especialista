              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{eventApiUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Evento con precio inválido\",\n  \"date\": \"2026-12-01T20:00:00Z\",\n  \"location\": \"Algún lugar\",\n  \"zones\": [ { \"name\": \"General\", \"price\": -1, \"capacity\": 10 } ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });"
